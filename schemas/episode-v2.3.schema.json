                }
              }
            },
            "else": {
              "properties": {
                "audio": {
                  "properties": {
                    "lines": {
                      "maxItems": 0
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "audio": {
                  "properties": {
                    "mode": {
                      "const": "ambience"
                    }
                  }
                },
                "duration_seconds": {
                  "enum": [
                    6,
                    8,
                    10
                  ]
                }
              }
            },
            "then": {
              "required": [
                "duration_reason"
